#!/usr/bin/env bash
set -e

SCRIPT_PATH="${BASH_SOURCE[0]}"
if [[ "$SCRIPT_PATH" != */* && ! -e "$SCRIPT_PATH" ]]; then
  SCRIPT_PATH="$(type -P "$SCRIPT_PATH")"
fi
LINK_COUNT=0
while [[ -L "$SCRIPT_PATH" ]]; do
  ((LINK_COUNT += 1))
  if (( LINK_COUNT > 20 )); then
    echo "uim: too many launcher symlink redirects." >&2
    exit 69
  fi
  LINK_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_PATH="$LINK_DIR/$LINK_TARGET"
  fi
done
DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT="$(cd "$DIR/../../.." && pwd)"
MANIFEST="$ROOT/crates/ui-master-engine/Cargo.toml"
COMMAND="${1:-}"

case "${UIM_CARGO_RUN:-auto}" in
  auto|0|false) FORCE_CARGO=0 ;;
  1|true) FORCE_CARGO=1 ;;
  *)
    echo "uim: invalid UIM_CARGO_RUN value; use auto, 0, false, 1, or true." >&2
    exit 2
    ;;
esac

# A deliberately limited scan must be requested explicitly. Handle it before
# engine discovery so external binaries cannot reinterpret --partial as full.
if [[ "$COMMAND" == audit ]]; then
  for ARG in "$@"; do
    if [[ "$ARG" == --partial ]]; then
      if [[ ! -f "$DIR/bridge.py" ]] || ! command -v python3 >/dev/null 2>&1; then
        echo "uim: partial audit requires bridge.py and python3." >&2
        exit 69
      fi
      exec python3 "$DIR/bridge.py" "$@"
    fi
  done
fi

# PATH can contain this script or the package's Node shim, which calls back
# into this script when no compiled engine is present.
is_own_launcher() {
  [[ "$1" -ef "${BASH_SOURCE[0]}" ]] || \
    [[ -f "$ROOT/bin/ui-master.js" && "$1" -ef "$ROOT/bin/ui-master.js" ]]
}

# Old independent/local binaries can still emit pre-contract success-shaped
# audit JSON. Refuse their audit path until the executable proves v1 coverage.
verified_audit_engine() {
  local CAPABILITY RULE
  CAPABILITY="$("$1" audit-contract --json 2>/dev/null)" || return 1
  CAPABILITY="${CAPABILITY//[[:space:]]/}"
  [[ "$CAPABILITY" == *'"audit_contract":"comprehensive-v1"'* ]] || return 1
  [[ "$CAPABILITY" == *'"engine":"rust"'* ]] || return 1
  for RULE in anti-slop/purple-gradient layout/viewport-hscreen motion/layout-thrashing \
              a11y/focus-outline layout/arbitrary-spacing typography/excess-scale; do
    [[ "$CAPABILITY" == *"\"$RULE\""* ]] || return 1
  done
}

while IFS= read -r EXTERNAL; do
  if [[ -n "$EXTERNAL" ]] && ! is_own_launcher "$EXTERNAL"; then
    if [[ "$COMMAND" != audit ]] || verified_audit_engine "$EXTERNAL"; then
      exec "$EXTERNAL" "$@"
    fi
    echo "uim: ignoring unverified audit executable: $EXTERNAL" >&2
  fi
done < <(type -aP uim 2>/dev/null || true)
if [[ -n "${HOME:-}" && -x "$HOME/.bun/bin/uim" ]] && ! is_own_launcher "$HOME/.bun/bin/uim"; then
  if [[ "$COMMAND" != audit ]] || verified_audit_engine "$HOME/.bun/bin/uim"; then
    exec "$HOME/.bun/bin/uim" "$@"
  fi
  echo "uim: ignoring unverified audit executable: $HOME/.bun/bin/uim" >&2
fi
# The Node/Bun adapter also supported this native installation name before
# strict audits began routing through the shell launcher.
if [[ "$COMMAND" == audit && -n "${HOME:-}" && -x "$HOME/.bun/bin/ui-master-engine" ]]; then
  if verified_audit_engine "$HOME/.bun/bin/ui-master-engine"; then
    exec "$HOME/.bun/bin/ui-master-engine" "$@"
  fi
  echo "uim: ignoring unverified audit executable: $HOME/.bun/bin/ui-master-engine" >&2
fi
for ENGINE in "$ROOT/crates/ui-master-engine/target/release/ui-master-engine" \
              "$ROOT/crates/ui-master-engine/target/debug/ui-master-engine"; do
  if [[ -x "$ENGINE" ]]; then
    if [[ "$COMMAND" != audit ]] || verified_audit_engine "$ENGINE"; then
      exec "$ENGINE" "$@"
    fi
    echo "uim: ignoring unverified audit executable: $ENGINE" >&2
  fi
done

case "$COMMAND" in
  ''|help|-h|--help)
    printf '%s\n' \
      'Usage: uim <command> [arguments]' \
      '  contrast <fg> <bg> [--json]  Color contrast (Python or Rust)' \
      '  audit <path> [--json]       Complete UI audit (native Rust required)' \
      '  audit <path> --partial [--json]  Limited Python audit (exit 3)' \
      '  crx <dir> [--json]         Chrome extension audit (Rust)' \
      '  skills <query> [--json]    Local skills search (Rust)' \
      '  mcp                        JSON-RPC stdio server (Rust)' \
      '  rig <list|call>            Native tool interface (Rust)' \
      '  get-skill <slug>           Read locally cached skill (Rust)' \
      '  trace <init|step|show>     Local trace ledger (Rust)'
    exit 0
    ;;
esac

case "$COMMAND" in
  contrast) BRIDGE_SUPPORTED=1 ;;
  audit|crx|skills|mcp|rig|get-skill|trace) BRIDGE_SUPPORTED=0 ;;
  *)
    echo "uim: unknown command '$COMMAND'. Available: contrast, audit, crx, skills, mcp, rig, get-skill, trace." >&2
    exit 2
    ;;
esac

if [[ "$BRIDGE_SUPPORTED" -eq 1 && "$FORCE_CARGO" -eq 0 ]]; then
  if [[ ! -f "$DIR/bridge.py" ]] || ! command -v python3 >/dev/null 2>&1; then
    echo "uim: '$COMMAND' requires the Python bridge, but bridge.py or python3 is unavailable." >&2
    exit 69
  fi
  exec python3 "$DIR/bridge.py" "$@"
fi

if [[ ! -f "$MANIFEST" ]]; then
  echo "uim: '$COMMAND' requires the native Rust engine; its Cargo manifest is not bundled here." >&2
  echo "Install a compiled uim executable on PATH, or build the engine from a full source checkout with Cargo." >&2
  if [[ "$COMMAND" == audit ]]; then
    echo "For a non-verifying h-screen-only scan, explicitly use: uim audit <path> --partial --json (exit 3)." >&2
  fi
  exit 69
fi
if ! command -v cargo >/dev/null 2>&1; then
  echo "uim: '$COMMAND' requires the native Rust engine, but Cargo is not available on PATH." >&2
  echo "Install Rust/Cargo and build with: cargo build --locked --manifest-path '$MANIFEST'" >&2
  if [[ "$COMMAND" == audit ]]; then
    echo "Alternatively request a limited, non-verifying scan with --partial (exit 3)." >&2
  fi
  exit 69
fi

# Cargo must not download dependencies implicitly during an ordinary CLI/MCP call.
exec cargo run --offline --locked --quiet --manifest-path "$MANIFEST" -- "$@"
